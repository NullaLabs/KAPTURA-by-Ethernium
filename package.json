{
  "name": "kaptura-by-ethernium",
  "version": "1.0.1",
  "description": "Local-first CHRONO capture studio with real in-browser transcoding (Lanczos + native GIF89a) and an honest handoff to the independent UPSKALETOR engine.",
  "type": "commonjs",
  "scripts": {
    "test": "node tests/test_gif_encoder.js && node tests/test_lanczos.js",
    "test:gif": "node tests/test_gif_encoder.js",
    "test:lanczos": "node tests/test_lanczos.js",
    "validate": "python tests/validate_kaptura.py",
    "serve": "python -m http.server 8000"
  },
  "keywords": ["screen-recorder", "transcoder", "lanczos", "gif-encoder", "webgl", "local-first", "ethernium"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NullaLabs/KAPTURA-by-Ethernium"
  }
}
